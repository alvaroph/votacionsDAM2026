FROM node:22-alpine

ENV NODE_ENV=production
WORKDIR /usr/src/app

# Només dependències de producció (sense nodemon)
COPY package*.json ./
RUN npm ci --omit=dev

COPY server.js ./

# Directori per persistir els vots (es munta com a volum)
RUN mkdir -p data && chown -R node:node /usr/src/app
USER node

EXPOSE 3000

CMD ["node", "server.js"]
